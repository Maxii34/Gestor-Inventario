# URL base del backend (sin secretos).
# El backend expone sus rutas en la raíz, sin prefijo /api.
# Esta plantilla NO se usa en ejecución, solo como referencia.
# Copia a .env.local para desarrollo o a .env.production para deploy.
#
# Desarrollo local (archivo .env.local):
# NEXT_PUBLIC_API_URL=http://localhost:3001
#
# Producción / deploy (archivo .env.production + variable en Vercel):
# NEXT_PUBLIC_API_URL=https://gestor-inventario-back.vercel.app